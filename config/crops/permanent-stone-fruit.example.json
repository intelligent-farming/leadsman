    {
      "//": "═══ BLOOM FREEZE ═══ WSU critical temperatures, 30-minute exposure, as 10 % kill / 90 % kill. Peach and nectarine: full bloom −2.8 / −4.4 °C, post-bloom −2.2 / −3.9 °C. Sweet cherry: full bloom and post-bloom −2.2 / −3.9 °C. Apricot: full bloom −2.8 / −5.6 °C. The 10 % figure is the warning; the 90 % figure is the loss. Source: WSU critical temperatures for frost damage on fruit trees (30-minute exposure), as reprinted in USU IPM-012-11, https://extension.usu.edu/productionhort/files/CriticalTemperaturesFrostDamageFruitTrees.pdf ; https://cpg.treefruit.wsu.edu/critical-temperatures/"
    },
    {
      "rule": "measurement-peak",
      "as": "peach-freeze-bloom-10pct",
      "severity": "critical",
      "activeMonths": [2, 3],
      "resolveOutOfSeason": true,
      "params": {
        "paths": ["air.temperature", "temperature"],
        "direction": "min",
        "threshold": -2.8,
        "unit": "C",
        "lookbackHours": 12,
        "minSamples": 3,
        "deviceNamePattern": "%peach%"
      }
    },
    {
