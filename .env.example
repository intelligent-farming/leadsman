#
# Copy to .env for the standalone dev compose. Never commit .env — it is gitignored.
# In the real deployment these values come from the stack's own .env; see
# docs/stack-fragment.yml.

# ── dev Postgres (docker-compose.yml only) ───────────────────────────────────
DEV_POSTGRES_USER=events
DEV_POSTGRES_PASSWORD=changeme
DEV_POSTGRES_DB=chirpstack_events
DEV_POSTGRES_HOST_PORT=5435

# ── engine ───────────────────────────────────────────────────────────────────
LEADSMAN_LOG_LEVEL=debug
LEADSMAN_LOG_FORMAT=text

# Names this edge device in every message it delivers: "Alert from <name>: <alert>".
# Set it when several devices report into the same channel or group chat. Blank counts as
# unset, and an unnamed install reports as "Alert from Leadsman".
LEADSMAN_INSTANCE_NAME=

# Bearer token sent to notify.webhookUrl, if the receiver requires one. Kept out of
# the config file so config/leadsman.json stays committable.
LEADSMAN_WEBHOOK_TOKEN=

# Set to true to let `migrate` apply migrations/002_event_indexes.sql, which creates
# indexes on ChirpStack-owned event_* tables. Off by default so that is a decision,
# not a side effect.
LEADSMAN_APPLY_EVENT_INDEXES=false

# ── gateway checks (optional) ────────────────────────────────────────────────
# Path to the JSON file holding the network server's chirpStackUrl, apiKey and
# tenantId. In intelligent-farming-stack the provisioner writes /shared/config.json
# on every start — mount that volume read-only and point this at it. The API key is
# read ONLY from this file, never from config/leadsman.json, which stays committable.
#
# This unlocks gateway-deaf and gateway-never-seen. rx_info already shows which
# gateways ARE forwarding, so a gateway that stopped is covered without it; what it
# cannot show is a gateway that is connected and hearing nothing, or one registered
# and never heard from — both are simply absent from the telemetry. Unset, those two
# checks report `skipped` rather than quietly finding nothing.
LEADSMAN_CHIRPSTACK_CONFIG=
# Override the URL / tenant from that file if you need to.
LEADSMAN_CHIRPSTACK_URL=
LEADSMAN_CHIRPSTACK_TENANT_ID=

# ── host address (optional) ──────────────────────────────────────────────────
# The address gateways are configured to forward to. Leadsman cannot discover this
# itself: it runs in a bridged container, where the only visible addresses are on the
# docker network. Defaults to reading `gatewayBridgeHost` from the file above, which
# is the host LAN address the stack detected and handed to its gateways.
#
# Set this directly only for a non-stack install. It enables host-address-changed —
# the check that reports a new DHCP lease as the cause of a site going dark, rather
# than leaving it to be inferred from silence.
LEADSMAN_HOST_ADDRESS=
LEADSMAN_HOST_ADDRESS_CONFIG=

# ── heartbeat (optional) ─────────────────────────────────────────────────────
# Where to POST a liveness ping after every sounding, for an external receiver to
# alarm on when the pings stop.
#
# This is the only signal that survives the edge device being off. Every check in this
# engine works by finding something wrong in the data, which requires the engine to be
# running — so a power cut, a panic, or a container that never came back produces no
# alerts at all, and looks exactly like a quiet night. The receiver has to be somewhere
# the outage cannot reach; a watchdog on the same box dies with it.
#
# Test it with: leadsman test-notify --to heartbeat
LEADSMAN_HEARTBEAT_URL=
# Secret for the heartbeat endpoint, if it authenticates. Falls back to
# LEADSMAN_WEBHOOK_TOKEN. Only used when heartbeat.auth is hmac or token.
LEADSMAN_WEBHOOK_TOKEN_HEARTBEAT=
